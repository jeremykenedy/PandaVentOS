*.json
.DS_Store
analysis/
build/
managed_components/
sdkconfig
frames/
reference-BEFORE.json
reference-timeline.json
seed_live.h
shots-*/
ui-comparison.png

# Anything specific to one device: full-flash backups, settings snapshots,
# notes carrying Wi-Fi credentials or the printer's access code. The folder
# and its README ship, the contents never do.
private/*
!private/.gitkeep
!private/README.md

# compiled host harnesses
tools/fxdump/fxdump
tools/fxdump/framecheck
tools/uicmp/harness
tools/uicmp/harness_live

# compiled config-migration harness
tools/cfgmig/cfgmig

# local pre-overwrite backups, never committed
*.prev
tools/cfgmig/migcheck

# The web app's gzip is BUILT from firmware/main/ui.html, which is the source
# of truth and is committed. The gzip is not: macOS gzip and GNU gzip produce
# different bytes from identical input, so committing it means every developer
# on the other platform shows a modified file they did not touch. CMake
# regenerates it whenever ui.html is newer, before the embed reads it.
firmware/main/factory_index.html.gz
